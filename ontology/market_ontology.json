{
  "ontology": "IntradayMarketOntology",
  "version": "1.0",
  "entities": {
    "Stock": {
      "attributes": [
        "symbol",
        "company_name",
        "sector",
        "price",
        "volume"
      ]
    },
    "Market": {
      "attributes": [
        "index",
        "trend",
        "volatility",
        "market_regime"
      ]
    },
    "News": {
      "attributes": [
        "headline",
        "source",
        "timestamp",
        "sentiment",
        "impact"
      ]
    },
    "Indicator": {
      "types": [
        "SMA",
        "EMA",
        "RSI",
        "MACD",
        "VWAP",
        "ATR",
        "ADX",
        "BollingerBands"
      ]
    },
    "Strategy": {
      "attributes": [
        "name",
        "timeframe",
        "conditions",
        "entry_rule",
        "exit_rule"
      ]
    },
    "TradePlan": {
      "attributes": [
        "symbol",
        "direction",
        "entry",
        "stop_loss",
        "target",
        "risk_reward"
      ]
    }
  },
  "relationships": [
    "Stock belongs_to Sector",
    "News affects Stock",
    "Indicator describes Stock",
    "Market determines MarketRegime",
    "MarketRegime influences Strategy",
    "Strategy generates TradePlan",
    "TradePlan belongs_to Stock"
  ]
}
